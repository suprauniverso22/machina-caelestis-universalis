{
    "name":  "machina-caelestis-universalis",
    "version":  "1.0.0",
    "private":  true,
    "type":  "module",
    "description":  "Computadora celestial interactiva de astronomía y calendarios históricos.",
    "author":  {
                   "name":  "Machina Caelestis Universalis",
                   "email":  "maintainers@machina-caelestis.invalid"
               },
    "main":  "electron/main.cjs",
    "scripts":  {
                    "dev":  "vite --host 127.0.0.1",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "desktop:dev":  "concurrently -k \"npm run dev -- --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 \u0026\u0026 cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
                    "build:linux":  "npm run build \u0026\u0026 electron-builder --linux",
                    "build:win":  "npm run build \u0026\u0026 electron-builder --win",
                    "preview":  "vite preview --host 127.0.0.1",
                    "test":  "vitest run",
                    "test:e2e":  "playwright test"
                },
    "dependencies":  {
                         "@react-three/drei":  "10.7.0",
                         "@react-three/fiber":  "9.3.0",
                         "astronomy-engine":  "2.1.19",
                         "lucide-react":  "0.468.0",
                         "react":  "19.1.0",
                         "react-dom":  "19.1.0",
                         "three":  "0.180.0",
                         "zustand":  "5.0.8"
                     },
    "devDependencies":  {
                            "@playwright/test":  "1.63.0",
                            "@types/node":  "24.0.0",
                            "@types/react":  "19.1.0",
                            "@types/react-dom":  "19.1.0",
                            "@types/three":  "0.180.0",
                            "@vitejs/plugin-react":  "5.0.0",
                            "concurrently":  "^9.2.1",
                            "cross-env":  "^10.0.0",
                            "electron":  "^38.8.6",
                            "electron-builder":  "^26.0.12",
                            "typescript":  "5.9.2",
                            "vite":  "7.3.6",
                            "vite-plugin-pwa":  "1.0.3",
                            "vitest":  "4.1.11",
                            "wait-on":  "^8.0.4"
                        },
    "build":  {
                  "appId":  "com.machina.caelestis.universalis",
                  "productName":  "Machina Caelestis Universalis",
                  "asar":  true,
                  "files":  [
                                "dist/**/*",
                                "electron/**/*",
                                "ICON.png",
                                "package.json"
                            ],
                  "directories":  {
                                      "output":  "release"
                                  },
                  "linux":  {
                                "target":  [
                                               "AppImage",
                                               "deb"
                                           ],
                                "icon":  "ICON.png",
                                "category":  "Utility",
                                "maintainer":  "Machina Caelestis Universalis"
                            },
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "nsis",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "icon":  "ICON.png"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true
                           }
              },
    "allowScripts":  {
                         "electron@38.8.6":  true
                     },
    "engines":  {
                    "node":  "\u003e=22.12.0"
                }
}